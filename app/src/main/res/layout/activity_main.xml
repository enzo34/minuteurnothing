<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/noir"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="40dp">

        <TextView
            style="@style/Etiquette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/entete" />

        <!-- Le gros bouton rond : un appui et c'est parti. -->
        <FrameLayout
            android:id="@+id/bouton_principal"
            android:layout_width="264dp"
            android:layout_height="264dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/fond_cercle"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <fr.enzo.cachet45.VueMatrice
                    android:id="@+id/matrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/sous_matrice"
                    style="@style/Etiquette"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center" />

            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/consigne"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:maxWidth="320dp"
            android:textColor="@color/gris"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/bouton_secondaire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bouton_contour"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:textAllCaps="true"
            android:textColor="@color/blanc"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/titre_duree"
            style="@style/Etiquette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="@string/duree" />

        <LinearLayout
            android:id="@+id/ligne_durees"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <!-- La carte de la dernière prise ouvre l'historique complet. -->
        <LinearLayout
            android:id="@+id/carte_derniere_prise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/carte"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/derniere_prise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/blanc"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/voir_historique"
                android:textColor="@color/gris"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            style="@style/Etiquette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/sonnerie" />

        <TextView
            android:id="@+id/sonnerie_actuelle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/blanc"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bouton_sonnerie_systeme"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bouton_contour"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/sonnerie_choisir"
                android:textColor="@color/blanc"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/bouton_sonnerie_ecouter"
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@drawable/bouton_contour"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/symbole_ecouter"
                android:textColor="@color/blanc"
                android:textSize="15sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/bouton_sonnerie_fichier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bouton_contour"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/sonnerie_fichier"
            android:textColor="@color/blanc"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bouton_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bouton_contour"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/ajouter_widget"
            android:textColor="@color/blanc"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/bouton_tuile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bouton_contour"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/ajouter_tuile"
            android:textColor="@color/blanc"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
